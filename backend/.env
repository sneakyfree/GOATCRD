# GOATCRD Backend Environment Variables
# Copy to .env and update values

# Application
APP_NAME=GOATCRD
APP_VERSION=0.1.0
DEBUG=true
ENVIRONMENT=development

# API
API_PREFIX=/api/v1
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/goatcrd

# Redis
REDIS_URL=redis://localhost:6379/0

# Security (CHANGE IN PRODUCTION)
SECRET_KEY=your-super-secret-key-change-in-production-use-32-chars
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
ALGORITHM=HS256

# Audit
AUDIT_RETENTION_DAYS=2555

# Confidence
DEFAULT_CONFIDENCE_CAP=100
UNKNOWN_FIELD_CONFIDENCE_CAP=50
CONTRADICTION_CONFIDENCE_CAP=60
