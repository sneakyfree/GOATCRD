# Copy to .env and adjust for your environment:
#   cp .env.example .env

# Base URL the SPA calls for the API.
# Must include the /api/v1 prefix. If unset, most callers fall back to
# the relative '/api/v1' (proxied by vite.config.ts in dev), while
# src/api/client.ts falls back to http://localhost:8000/api/v1.
VITE_API_URL=http://localhost:8847/api/v1
